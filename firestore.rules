rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to verify user is authenticated and accessing their own path
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper functions for validating set writes
    function isValidSet(data) {
      return data.weight is number && data.weight >= 0
          && data.reps is int && data.reps > 0
          && data.isPR is bool;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User document path rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /sets/{setId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSet(request.resource.data);
      }

      match /customExercises/{exerciseId} {
        allow read, write: if isOwner(userId);
      }

      match /bodyweightLog/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
